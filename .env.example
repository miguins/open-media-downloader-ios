# Local Compose development settings. Unset variables use the defaults shown in
# comments; a variable that is set but empty or invalid stops startup.
OMDI_HTTP_ADDR=:8080
OMDI_DEV_UID=1000
OMDI_DEV_GID=1000
# Host interface that Compose publishes port 8080 on. Use 0.0.0.0 only for a
# trusted local network, and set OMDI_PUBLIC_URL to an address clients can reach.
# OMDI_PUBLISH_HOST=127.0.0.1

# OMDI_DATA_DIR=/data
# OMDI_ALLOWED_PLATFORMS=youtube,instagram,tiktok,x,reddit,vimeo
# OMDI_MAX_URL_LENGTH=2048
# OMDI_MAX_REQUEST_BYTES=16384
# OMDI_JOB_TIMEOUT=10m
# OMDI_MAX_JOB_BYTES=2147483648
# OMDI_MIN_FREE_BYTES=1073741824
# OMDI_JOB_RETENTION=24h
# OMDI_TOKEN_TTL=15m
# OMDI_YTDLP_PATH=/opt/media-tools/bin/yt-dlp
# OMDI_GALLERYDL_PATH=/opt/media-tools/bin/gallery-dl
# OMDI_FFMPEG_PATH=/opt/ffmpeg/bin/ffmpeg
# OMDI_FFPROBE_PATH=/opt/ffmpeg/bin/ffprobe
# OMDI_PUBLIC_URL=http://localhost:8080
# OMDI_MAX_QUEUED_JOBS=10
# OMDI_MAX_JOB_ITEMS=20
